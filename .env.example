# Copier ce fichier vers .env, puis adapter les valeurs.
# Le fichier .env n’est jamais versionné.

# MongoDB de développement (docker-compose.dev.yml).
# directConnection=true contourne le nom d’hôte annoncé par le replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/circuits?directConnection=true
# Facultatif : nom de base utilisé par migrate-mongo.
MONGODB_DB=circuits

# API de développement.
HOST=127.0.0.1
PORT=3101

# Signature des cookies (session et fixation d'appareil). 32 caractères
# minimum. En production l'API refuse de démarrer sans cette valeur.
# Générer avec : openssl rand -base64 48
COOKIE_SECRET=
# Origine utilisée pour construire les liens d'invitation affichés aux adultes.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Laisser vide en développement : les cookies ne sont pas Secure en HTTP.
COOKIE_SECURE=false
# Derrière Caddy uniquement, pour lire X-Forwarded-For (limitation par IP).
TRUST_PROXY=false

# Compte administrateur. Identifiant court, sans e-mail.
# Utilisé par `admin:create` et par le seed de démo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please-1234
ADMIN_NAME=Administrateur
