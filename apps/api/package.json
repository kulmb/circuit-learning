{
  "name": "@circuits/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3101 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "migrate-mongo up",
    "db:migrate:status": "migrate-mongo status",
    "db:migrate:down": "migrate-mongo down",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "admin:password": "tsx src/scripts/setPassword.ts",
    "e2e:server": "tsx test/e2e/server.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@circuits/shared": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "argon2": "^0.41.1",
    "dotenv": "^18.0.9",
    "fastify": "^4.28.1",
    "mongoose": "^9.11.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "migrate-mongo": "^14.0.7",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
