# Déploiement de développement (docker-compose.dev-deploy.yml).
# Copier ce fichier vers .env.dev puis renseigner COOKIE_SECRET.
# .env.dev n'est jamais versionné.

# Signature des cookies. 32 caractères minimum.
# Générer avec : openssl rand -base64 48
COOKIE_SECRET=

# Facultatif : origine publique du domaine de développement.
# PUBLIC_ORIGIN=https://circuit-learning-dev.87543362.xyz

# Authentification MongoDB (docker-compose.dev-deploy.yml).
# Générer avec : openssl rand -hex 24
MONGO_APP_USER=circuitsApp
MONGO_APP_PASSWORD=
MONGO_APP_DB=circuits
MONGO_ROOT_USER=zapRoot
MONGO_ROOT_PASSWORD=
# Facultatif : chemin absolu de la keyFile hors du dépôt.
# MONGO_KEYFILE_PATH=/etc/circuits/mongo-dev-keyfile
